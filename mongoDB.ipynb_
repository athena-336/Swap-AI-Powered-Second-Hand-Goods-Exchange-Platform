l 'pymongo[srv]'"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"5uzzoh-SZNhZ","executionInfo":{"status":"ok","timestamp":1698855386964,"user_tz":-480,"elapsed":9807,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"4287ad03-cfde-4dfa-9d24-89abd807578e"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Requirement already satisfied: pymongo[srv] in /usr/local/lib/python3.10/dist-packages (4.5.0)\n","Requirement already satisfied: dnspython<3.0.0,>=1.16.0 in /usr/local/lib/python3.10/dist-packages (from pymongo[srv]) (2.4.2)\n"]}]},{"cell_type":"code","source":["import pymongo\n","import dns\n","# 設定 MongoDB 的連接字串\n","connection_string = \"mongodb+srv://swap:swap@swap.2nka9hz.mongodb.net/huatest?retryWrites=true&w=majority\"\n","\n","# 建立 MongoDB 連接\n","client = pymongo.MongoClient(connection_string)\n","\n","# 連接到指定的資料庫\n","db = client['huatest']\n","\n","# 連接到指定的集合\n","collection = db['huatest']"],"metadata":{"id":"G4Jk9FVlZPwz"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["from gridfs import GridFS\n","import cv2\n","image = cv2.imread('/content/drive/Shareddrives/final_project/Project/test_image/backpack.jpg')\n","\n","# 將圖片轉換為 JPEG 格式的二進位數據\n","_, image_binary = cv2.imencode('.jpg', image)\n","\n","fs = GridFS(db)\n","\n","# 將二進位數據存儲到 GridFS\n","file_id = fs.put(image_binary.tobytes(), filename=\"image.jpg\", content_type=\"image/jpeg\")\n","\n","results = []\n","result = {\n","  \"照片\": file_id,\n","    }\n","\n","results.append(result)\n","\n","#將結果插入 MongoDB\n","collection.insert_many(results)\n","\n","print(\"結果已成功插入 MongoDB\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"jjGu3yGkYSdo","executionInfo":{"status":"ok","timestamp":1691843614531,"user_tz":-480,"elapsed":6016,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"87769f8a-2c2b-4c22-df97-28a316f1c774"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["結果已成功插入 MongoDB\n"]}]},{"cell_type":"code","source":["from IPython.display import display, HTML\n","display(HTML(\"<style>.container { width:100% !important; }</style>\"))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":17},"id":"sBwrGpHdZe9F","executionInfo":{"status":"ok","timestamp":1691133575002,"user_tz":-480,"elapsed":13,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"26138126-b93c-49f3-88b7-db341321bdc3"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["<style>.container { width:100% !important; }</style>"]},"metadata":{}}]},{"cell_type":"markdown","source":["#檢查DB裡有沒有這東西"],"metadata":{"id":"EaddnFGkvCfT"}},{"cell_type":"code","source":["!pip install opencv-python-headless"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"EiiOVNsphXu5","executionInfo":{"status":"ok","timestamp":1691843785327,"user_tz":-480,"elapsed":5415,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"487933fe-29b3-4b29-b8b5-a2671eb6f5f6"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Requirement already satisfied: opencv-python-headless in /usr/local/lib/python3.10/dist-packages (4.8.0.76)\n","Requirement already satisfied: numpy>=1.21.2 in /usr/local/lib/python3.10/dist-packages (from opencv-python-headless) (1.23.5)\n"]}]},{"cell_type":"code","source":["import gridfs\n","import numpy as np\n","import bson\n","from google.colab.patches import cv2_imshow\n","# 初始化 GridFS\n","fs = gridfs.GridFS(db)\n","\n","# 要查詢的文件 ID\n","image_id = \"64d72b9aa5d57895c9febe69\"  # 替換為實際的文件 ID\n","\n","# 從 GridFS 中獲取文件對象，並讀取數據\n","file = fs.find_one({\"_id\": bson.ObjectId(image_id)})\n","if file is not None:\n","    image_data = file.read()\n","\n","    # 將二進制數據轉換為圖片\n","    image = cv2.imdecode(np.frombuffer(image_data, np.uint8), cv2.IMREAD_COLOR)\n","\n","    if image is not None:\n","        cv2_imshow(image)\n","    else:\n","        print(\"無法轉換圖片數據\")\n","else:\n","    print(\"找不到指定的文件\")\n"],"metadata":{"id":"TdyBUmR2antH","colab":{"base_uri":"https://localhost:8080/","height":662},"executionInfo":{"status":"ok","timestamp":1691843790965,"user_tz":-480,"elapsed":5654,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"4a28761d-740e-464b-9b78-b72b57de9488"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<PIL.Image.Image image mode=RGB size=2000x2000>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","source":["#放進MongoDB+64"],"metadata":{"id":"T_wizlMi_WC3"}},{"cell_type":"code","source":["from google.colab import drive\n","drive.mount('/content/drive')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ItMDPXkC_aLK","executionInfo":{"status":"ok","timestamp":1698728144097,"user_tz":-480,"elapsed":19227,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"098af5d0-a00d-4190-b85e-c995008b0b15"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}]},{"cell_type":"code","source":["pip install --upgrade pymongo dnspython"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mdoD9sKI_dqz","executionInfo":{"status":"ok","timestamp":1698728152572,"user_tz":-480,"elapsed":8478,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"a47524bf-33cd-4f1a-dee7-c24b8d2195d2"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Collecting pymongo\n","  Downloading pymongo-4.5.0-cp310-cp310-manylinux_2_17_x86_64.manylinux2014_x86_64.whl (671 kB)\n","\u001b[2K     \u001b[90m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[0m \u001b[32m671.3/671.3 kB\u001b[0m \u001b[31m10.0 MB/s\u001b[0m eta \u001b[36m0:00:00\u001b[0m\n","\u001b[?25hCollecting dnspython\n","  Downloading dns