ython, pymongo\n","Successfully installed dnspython-2.4.2 pymongo-4.6.1\n"]}]},{"cell_type":"code","source":["pip install 'pymongo[srv]'"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"CTlQusMwsCgO","executionInfo":{"status":"ok","timestamp":1702217221145,"user_tz":-480,"elapsed":12720,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"bbe22122-39e9-4481-b218-b96e21e063f3"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Requirement already satisfied: pymongo[srv] in /usr/local/lib/python3.10/dist-packages (4.6.1)\n","Requirement already satisfied: dnspython<3.0.0,>=1.16.0 in /usr/local/lib/python3.10/dist-packages (from pymongo[srv]) (2.4.2)\n"]}]},{"cell_type":"code","source":["import pymongo\n","import dns\n","# 設定 MongoDB 的連接字串\n","connection_string = \"mongodb+srv://swap:swap@swap.2nka9hz.mongodb.net/huatest64?retryWrites=true&w=majority\"\n","\n","# 建立 MongoDB 連接\n","client = pymongo.MongoClient(connection_string)\n","\n","# 連接到指定的資料庫\n","db = client['huatest64']\n","\n","# 連接到指定的集合\n","collection = db['items']"],"metadata":{"id":"PDuO9SjSsG7Y","executionInfo":{"status":"ok","timestamp":1702217221633,"user_tz":-480,"elapsed":506,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}}},"execution_count":4,"outputs":[]},{"cell_type":"code","source":["# 導入需要的資料\n","import io\n","import os\n","from PIL import Image\n","\n","image_path = \"/content/drive/Shareddrives/final_project/Project/test_image/adshirts.jpg\"\n","# 打開圖像文件\n","if os.path.exists(image_path):\n","\n","  with open(image_path, 'rb') as image_file:\n","      image_data = image_file.read()\n","\n","  # 將圖像數據儲存為二進制\n","  binary_image = io.BytesIO(image_data).read()\n","\n","  # 將二進制的照片存儲到MongoDB\n","  image_data = {\n","      \"照片二進制\": binary_image\n","  }\n","  insert_result = collection.insert_one(image_data)\n","\n","if insert_result.acknowledged:\n","    print(\"照片已成功存儲到MongoDB\")\n","else:\n","    print(\"照片存儲失敗\")\n","# 将二进制数据存储到MongoDB或其他地方"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"tETYL_H-siSJ","executionInfo":{"status":"ok","timestamp":1702217227612,"user_tz":-480,"elapsed":3579,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"c2117a03-e4c1-42b0-afae-8e711505657a"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["照片已成功存儲到MongoDB\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"q26Z308W4vb_"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["#測試LOGO"],"metadata":{"id":"DmsjuGE96s-h"}},{"cell_type":"code","source":["# 導入需要的資料\n","import io\n","import os\n","import requests\n","import json\n","import cv2\n","import numpy as np\n","from io import BytesIO\n","from PIL import Image\n","\n","image_path = \"/content/drive/Shareddrives/final_project/Project/test_image/backpack.jpg\"\n","# 打開圖像文件\n","if os.path.exists(image_path):\n","\n","  with open(image_path, 'rb') as image_file:\n","      image_data = image_file.read()\n","\n","  # 將圖像數據儲存為二進制\n","  binary_image = io.BytesIO(image_data).read()"],"metadata":{"id":"R0qtrEjW6vrz"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["\n","# LOGO辨識\n","def perform_logo_detection(image):\n","  headers = {\"Authorization\": \"Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiMzhlY2FkNTUtMTc1YS00NzNjLWE4NjctMzVhOTQ1OTk5ZjY5IiwidHlwZSI6ImFwaV90b2tlbiJ9.UZq2qlgfCguM5HN_mJJO8pvB9EiFBcHb-I-r2TB2NBU\"}  # 替換為你的 API 金鑰\n","  url = \"https://api.edenai.run/v2/image/logo_detection\"\n","  data = {\"providers\": \"google\"}\n","  _, image_path = cv2.imencode('.jpg',image)\n","  files = {'file':('image.jpg',image_path.tobytes(),'image/jpeg')}  # 替換為實際的輸入圖像路徑\n","  response = requests.post(url, data=data, files=files, headers=headers)\n","  result = json.loads(response.text)\n","  return result\n"],"metadata":{"id":"lcOK8G0U6zVo"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["image = Image.open(BytesIO(binary_image))\n","# 將PIL圖像轉換為NumPy數組\n","image_np = cv2.cvtColor(np.array(image), cv2.COLOR_RGB2BGR)"],"metadata":{"id":"IOp6wM4F64xj"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["logo_result = perform_logo_detection(image_np)\n","description = 'unknown brand'\n","if 'google' in logo_result and 'items' in logo_result['google']:\n","  items = logo_result['google']['items']\n","  for item in items:\n","    score = round(item['score'],2)\n","    if score>0.7:\n","      description = item['description']\n","      print(\"LOGO: {}, Score: {}\".format(description, score))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"dM0ycZLu68pk","executionInfo":{"status":"ok","timestamp":1699019724988,"user_tz":-480,"elapsed":2282,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"a2a68012-3ca0-45bb-c3a6-878446fd08ab"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["LOGO: Nike, Score: 0.85\n"]}]},{"cell_type":"markdown","source":["#測試color"],"metadata":{"id":"1Zvhddwn_u8z"}},{"cell_type":"code","source":["pip install colormath"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"NhF_YdvOEltk","executionInfo":{"status":"ok","timestamp":1698947073902,"user_tz":-480,"elapsed":6712,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"d0c5b064-2d82-42e2-b068-7d460103afb2"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Requirement already satisfied: colormath in /usr/local/lib/python3.10/dist-packages (3.0.0)\n","Requirement already satisfied: numpy in /usr/local/lib/python3.10/dist-packages (from colormath) (1.26.1)\n","Requirement already satisfied: networkx>=2.0 in /usr/local/lib/python3.10/dist-packages (from colormath) (3.2)\n"]}]},{"cell_type":"code","source":["image_path = \"/content/drive/Shareddrives/final_project/Project/test_image/lacap.jpg\"\n","# 打開圖像文件\n","if os.path.exists(image_path):\n","\n","  with open(image_path, 'rb') as image_file:\n","      image_data = image_file.read()\n","\n","  # 將圖像數據儲存為二進制\n","  binary_image = io.BytesIO(image_data).read()"],"metadata":{"id":"6aiSptk6ACD2"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["image = Image.open(BytesIO(binary_image))\n","# 將PIL圖像轉換為NumPy數組\n","image_np = cv2.cvtColor(np.array(image), cv2.COLOR_RGB2BGR)"],"metadata":{"id":"pLKGROvgARj9"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["from sklearn.cluster import KMeans\n","from colormath.color_objects import sRGBColor, LabColor\n","from colormath.color_diff import delta_e_cie2000\n","from colormath import color_conversions\n","\n","def rgb_to_lab(rgb_color):\n","    # 將 sRGBColor 轉換為 LabColor\n","    lab_color = color_conversions.convert_color(rgb_color, LabColor)\n","    return lab_color\n","\n","\n","def find_top_colors(image):\n","  # 將照片轉換為NumPy陣列\n","  image_array = np.array(image)\n","\n","  # 將三維的照片陣列轉換為二維的色彩特徵陣列\n","  h, w, _ = image_array.shape\n","  features = image_array.reshape(h * w, -1)\n","\n","  # 使用K-Means進行色彩分群\n","  num_clusters = 2  # 可自行調整分群數量\n","  kmeans = KMeans(n_clusters=num_clusters, random_state=0)\n","  kmeans.fit(features)\n","\n","  # 取得分群中心的顏色\n","  cluster_centers = kmeans.cluster_centers_.astype(int)\n","\n","\n","  # 顏色名稱映射字典（更多的中文顏色名稱）\n","  color_names = {\n","    (0, 0, 0): \"Black\",\n","#    (54, 69, 79): \"Charcoal\",\n","    (2, 48, 32): \"Dark Green\",\n","    (48, 25, 52): \"Dark Purple\",\n","    (52, 52, 52): \"Jet Black\",\n","#    (27, 18, 18): \"Licorice\",\n","    (40, 40, 43): \"Matte Black\",\n","    (25, 25, 112): \"Midnight Blue\",\n","#    (53, 57, 53): \"Onyx\",\n","#    (0, 255, 255): \"Aqua\",\n","#    (240, 255, 255): \"Azure\",\n","    (137, 207, 240): \"Baby Blue\",\n","    (0, 0, 255): \"Blue\",\n","    (115, 147, 179): \"Blue Gray\",\n","    (8, 143, 143): \"Blue Green\",\n","    (0, 150, 255): \"Bright Blue\",\n","    (95, 158, 160): \"Cadet Blue\",\n","    (0, 71, 171): \"Cobalt Blue\",\n","    (100, 149, 237): \"Cornflower Blue\",\n","#    (0, 255, 255): \"Cyan\",\n","    (0, 0, 139): \"Dark Blue\",\n","#    (111, 143, 175): \"Denim\",\n","    (20, 52, 164): \"Egyptian Blue\",\n","    (125, 249, 255): \"Electric Blue\",\n","#    (96, 130, 182): \"Glaucous\",\n","#    (0, 163, 108): \"Jade\",\n","#    (63, 0, 255): \"Indigo\",\n","#    (93, 63, 211): \"Iris\",\n","    (173, 216, 230): \"Light Blue\",\n","    (25, 25, 112): \"Midnight Blue\",\n","    (0, 0, 128): \"Navy Blue\",\n","    (31, 81, 255): \"Neon Blue\",\n","    (167, 199, 231): \"Pastel Blue\",\n","#    (204, 204, 255): \"Periwinkle\",\n","    (182, 208, 226): \"Powder Blue\",\n","    (150, 222, 209): \"Robin Egg Blue\",\n","    (65, 105, 225): \"Royal Blue\",\n","    (15, 82, 186): \"Sapphire Blue\",\n","    (159, 226, 191): \"Seafoam Green\",\n","    (135, 206, 235): \"Sky Blue\",\n","    (70, 130, 180): \"Steel Blue\",\n","#    (0, 128, 128): \"Teal\",\n","#    (64, 224, 208): \"Turquoise\",\n","#    (4, 55, 242): \"Ultramarine\",\n","#    (64, 181, 173): \"Verdigris\",\n","#    (8, 24, 168): \"Zaffre\",\n","    (234, 221, 202): \"Almond\",\n","#    (225, 193, 110): \"Brass\",\n","    (205, 127, 50): \"Bronze\",\n","    (165, 42, 42): \"Brown\",\n","#    (218, 160, 109): \"Buff\",\n","#    (128, 0, 32): \"Burgundy\",\n","#    (233, 116, 81): \"Burnt Sienna\",\n","#    (110, 38, 14): \"Burnt Umber\",\n","    (193, 154, 107): \"Camel\",\n","    (149, 69, 53): \"Chestnut\",\n","    (123, 63, 0): \"Chocolate\",\n","    (210, 125, 45): \"Cinnamon\",\n","    (111, 78, 55): \"Coffee\",\n","#    (131, 67, 51): \"Cognac\",\n","#    (184, 115, 51): \"Copper\",\n","#    (129, 65, 65): \"Cordovan\",\n","    (92, 64, 51): \"Dark Brown\",\n","    (139, 0, 0): \"Dark Red\",\n","    (152, 133, 88): \"Dark Tan\",\n","#    (194, 178, 128): \"Ecru\",\n","#    (193, 154, 107): \"Fallow\",\n","#    (229, 170, 112): \"Fawn\",\n","#    (154, 42, 42): \"Garnet\",\n","    (150, 105, 25): \"Golden Brown\",\n","#    (240, 230, 140): \"Khaki\",\n","    (196, 164, 132): \"Light Brown\",\n","#    (192, 64, 0): \"Mahogany\",\n","#    (128, 0, 0): \"Maroon\",\n","    (150, 121, 105): \"Mocha\",\n","    (242, 210, 189): \"Warm Pink\",\n","#    (204, 119, 34): \"Ochre\",\n","    (128, 128, 0): \"Olive Green\",\n","#    (74, 4, 4): \"Oxblood\",\n","#    (169, 92, 104): \"Puce\",\n","#    (165, 42, 42): \"Rust\",\n","#    (186, 85, 211): \"Amethyst\",\n","    (128, 0, 128): \"Purple\",\n","#    (75, 0, 130): \"Indigo\",\n","    (148, 0, 211): \"Violet\",\n","    (138, 43, 226): \"Blue Violet\",\n","    (255, 0, 0): \"Red\",\n","    (178, 34, 34): \"Firebrick\",\n","#    (220, 20, 60): \"Crimson\",\n","    (139, 0, 139): \"Dark Magenta\",\n","    (255, 0, 255): \"Magenta\",\n","    (255, 20, 147): \"Deep Pink\",\n","    (255, 105, 180): \"Hot Pink\",\n","    (255, 182, 193): \"Light Pink\",\n","    (199, 21, 133): \"Medium Violet Red\",\n","    (219, 112, 147): \"Pale Violet Red\",\n","    (255, 160, 122): \"Salmon\",\n","    (250, 128, 114): \"Salmon Pink\",\n","    (255, 69, 0): \"Tomato\",\n","    (255, 99, 71): \"Coral\",\n","    (255, 127, 80): \"Peach\",\n","    (255, 140, 105): \"Light Salmon\",\n","    (240, 128, 128): \"Light Coral\",\n","    (255, 105, 180): \"Hot Pink\",\n","    (255, 165, 0): \"Orange\",\n","    (255, 215, 0): \"Gold\",\n","    (255, 255, 0): \"Yellow\",\n","    (255, 255, 85): \"Light Yellow\",\n","    (238, 232, 170): \"Pale Goldenrod\",\n","#    (189, 183, 107): \"Khaki\",\n","    (184, 134, 11): \"Dark Goldenrod\",\n","#    (255, 228, 181): \"Moccasin\",\n","    (255, 222, 173): \"Navajo White\",\n","#    (255, 248, 220): \"Beige\",\n","    (255, 239, 184): \"Papaya Whip\",\n","    (245, 222, 179): \"Wheat\",\n","    (250, 235, 215): \"Antique White\",\n","    (255, 250, 205): \"Lemon Chiffon\",\n","    (255, 250, 240): \"Floral White\",\n","    (255, 255, 240): \"Ivory\",\n","#    (250, 240, 230): \"Linen\",\n","#    (253, 245, 230): \"Old Lace\",\n","    (255, 245, 238): \"Seashell\",\n","#    (255, 228, 196): \"Bisque\",\n","#    (255, 235, 205): \"Blanched Almond\",\n","    (255, 250, 250): \"Snow\",\n","    (240, 248, 255): \"Alice Blue\",\n","    (135, 206, 250): \"Light Sky Blue\",\n","    (100, 149, 237): \"Cornflower Blue\",\n","    (0, 191, 255): \"Deep Sky Blue\",\n","    (173, 216, 230): \"Light Blue\",\n","    (240, 248, 255): \"Alice Blue\",\n","    (135, 206, 235): \"Sky Blue\",\n","    (70, 130, 180): \"Steel Blue\",\n","#    (0, 128, 128): \"Teal\",\n","#    (64, 224, 208): \"Turquoise\",\n","#    (4, 55, 242): \"Ultramarine\",\n","#    (64, 181, 173): \"Verdigris\",\n","#    (8, 24, 168): \"Zaffre\",\n","      # 在這裡可以繼續添加更多的顏色\n","  }\n","\n","  # 計算每個分群的像素數量\n","  #pixel_counts = Counter(kmeans.labels_)\n","\n","  # 找到最常見的顏色\n","  #most_common_colors = [cluster_centers[i] for i, count in pixel_counts.most_common(num_colors)]\n","\n","\n","  # 顯示分群中心的顏色\n","  top_colors = []\n","  for color in cluster_centers:\n","    r, g, b = color\n","    # 創建sRGBColor對象\n","    srgb_color = sRGBColor(r, g, b, is_upscaled=True)\n","    # 將sRGBColor轉換為LabColor\n","    lab_color = rgb_to_lab(srgb_color)\n","    # 尋找最接近的已知顏色\n","    closest_color = min(color_names.keys(), key=lambda x: delta_e_cie2000(lab_color,rgb_to_lab(sRGBColor(*x, is_upscaled=True))))\n","    chinese_color_name = color_names.get(closest_color, \"未知顏色\")\n","    print(f\"顏色名稱: {chinese_color_name}\")\n","    top_colors.append(chinese_color_name)\n","  return top_colors"],"metadata":{"id":"8Yawcc8C7nzx"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["top_colors = find_top_colors(image)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":392},"id":"rcoIVQ7_APdb","executionInfo":{"status":"error","timestamp":1698947132619,"user_tz":-480,"elapsed":7991,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}},"outputId":"c