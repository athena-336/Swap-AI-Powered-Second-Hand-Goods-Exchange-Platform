,\n","    '1':'Trouser',\n","    '2':'Pullover',\n","    '3':'Dress',\n","    '4':'Coat',\n","    '5':'Sandal',\n","    '6':'Shirt',\n","    '7':'Sneaker',\n","    '8':'Bag',\n","    '9':'Ankle boot'\n","}"],"metadata":{"id":"7SkWAfvvfy2e"},"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"-iDHmLOs7L8u"},"source":["def my_predict(n):\n","    cat = name.get(str(y_predict[n]))\n","    print('我可愛的 CNN 預測是',cat)\n","    X = x_test[n].reshape(28,28)\n","    plt.imshow(X, cmap='Greys')"],"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"tzVJpLQz7L8u"},"source":["from ipywidgets import interact_manual"],"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"BGCogG2Q7L8u","colab":{"base_uri":"https://localhost:8080/","height":1000,"referenced_widgets":["30a6e2ea2f3e498ab562a4058602acae","c6439d577dda4541bc05d1310f3cbfd0","2322fe2320884de29f13e53d2454cc68","4c86341bf22a43cabca95f3de4407eb1","04c4f1e303724e9691d2926a9896f50d","6d3b01424714441b9373be2960e3d3a1","77578dbc37214f72a2578df2dff4800d","26b682701b0946a591ed18c4978f0b9d","d81be762af6a4894a6d31f5e59fc8ed1","9e1f59d2411d48b6bffa52c4af6cb29d"]},"outputId":"35a0e756-9560-40f0-c1a1-c26a6cb3d254","executionInfo":{"status":"ok","timestamp":1695289532799,"user_tz":-480,"elapsed":26,"user":{"displayName":"Mandy Hua","userId":"06386809639784045722"}}},"source":["interact_manual(my_predict, n=(0, 9999));"],"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["interactive(children=(IntSlider(value=4999, description='n', max=9999), Button(description='Run Interact', sty…"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"30a6e2ea2f3e498ab562a4058602acae"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/pn